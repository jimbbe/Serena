# Serena local environment example.
# Copy to .env only when a task needs real local configuration.

APP_ENV=local
NODE_ENV=development

# Host port exposed by the local core service.
CORE_PORT=3000

# Local PostgreSQL defaults for Docker Compose (examples only).
POSTGRES_DB=serena
POSTGRES_USER=serena
POSTGRES_PASSWORD=serena
POSTGRES_PORT=5432

# Core service DB environment (prepared for future use only).
# Inside Docker Compose, use the service hostname `postgres`.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=serena
DATABASE_USER=serena
DATABASE_PASSWORD=serena
DATABASE_URL=postgres://serena:serena@postgres:5432/serena

# For host-machine tools, use localhost with POSTGRES_PORT instead:
# postgres://serena:serena@localhost:5432/serena

# Internal shared-secret token for /internal/* endpoints.
# Must match X-Serena-Internal-Token header sent by internal callers.
# If not set, /internal/* returns 500 (misconfigured).
SERENA_INTERNAL_TOKEN=

# Future WhatsApp provider configuration. Keep real values only in .env.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# ── LLM Provider Configuration ──────────────────────────────────────
# AI_PROVIDER: "mock" (default, deterministic canned responses) or "openai-compatible" (real LLM).
# When set to "openai-compatible", AI_BASE_URL, AI_API_KEY, and AI_MODEL are required.
# AI_TIMEOUT_MS defaults to 30000 (30 seconds).
# NEVER commit real API keys. Keep them only in your local .env file.

AI_PROVIDER=mock
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-4o
# AI_TIMEOUT_MS=30000
