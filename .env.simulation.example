# Serena Simulation API — local/dev example only
# Copy this file to `.env` before running manual Simulation API tests.
# Do NOT use these values in production.

# Simulation API
ENABLE_SIMULATION_ENDPOINTS=true

# Provider mode
AI_PROVIDER=mock

# Real provider example
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=replace-with-your-key
# AI_MODEL=replace-with-model
# AI_TIMEOUT_MS=30000

# Server
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
APP_ENV=local

# Internal token for local /internal/* calls if needed
SERENA_INTERNAL_TOKEN=local-dev-token

# SECURITY: placeholders only.
# Keep real API keys only in your local `.env`, never in Git.
