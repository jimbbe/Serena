# Evolution API Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# --- Authentication ---
# API key for Evolution API authentication. Generate with: openssl rand -hex 32
AUTHENTICATION_API_KEY=

# --- PostgreSQL ---
# Database credentials for Evolution API's internal data store.
POSTGRES_DB=evolution
POSTGRES_USER=evo
POSTGRES_PASSWORD=

# --- Webhook ---
# URL where Evolution API sends webhook events.
# For MVP: points to the WhatsApp Gateway service on the internal Docker network.
WEBHOOK_GLOBAL_URL=http://whatsapp-gateway:3001/webhook/evolution

# --- Server ---
# Base URL of the Evolution API instance (used for QR codes and instance management).
# For internal Docker communication, use the container name.
# If external access is needed (e.g., for QR code URLs), use the VPS IP or domain.
EVOLUTION_SERVER_URL=http://evolution-api:8080
