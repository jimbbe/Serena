# T37 staging template — placeholders only.
# DO NOT commit real secrets. Copy to .env only on VPS.

GATEWAY_MODE=production
GATEWAY_PORT=3001

# Gateway role keys
GATEWAY_ADMIN_KEY=REPLACE_ADMIN_KEY
GATEWAY_APP_KEY=REPLACE_APP_KEY
GATEWAY_EVO_KEY=REPLACE_EVO_KEY

# Evolution API
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=REPLACE_EVOLUTION_API_KEY

# Gateway routing
GATEWAY_ROUTING_TABLE_PATH=/app/config/routing-table.json

# Serena internal token resolved by routing table auth.env
SERENA_INTERNAL_TOKEN=REPLACE_SERENA_INTERNAL_TOKEN

# Evolution dependencies
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=REPLACE_EVO_POSTGRES_PASSWORD

# Optional runtime hardening knobs
EVOLUTION_WEBHOOK_GLOBAL_URL=
